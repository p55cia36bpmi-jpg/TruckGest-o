rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection (autenticação, perfil, credenciais)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Drivers collection (cadastro de motoristas com CNH e credenciais)
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // 3. Vehicles collection (veículos e controle de manutenção)
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // 4. Daily Reports (relatórios diários de trabalho)
    match /dailyReports/{reportId} {
      allow read, write: if true;
    }

    // 5. Deliveries (entregas por cidade)
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    // 6. Fuel Records (abastecimentos)
    match /fuelRecords/{fuelRecordId} {
      allow read, write: if true;
    }

    // 7. Expenses (gastos diversos categorizados)
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // 8. Daily Rates (valores de diárias com vigência)
    match /dailyRates/{rateId} {
      allow read, write: if true;
    }

    // 9. Tolls (pedágios por rota e veículo)
    match /tolls/{tollId} {
      allow read, write: if true;
    }

    // 10. Payments (cálculo e quitação de pagamentos)
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 11. Maintenance (histórico de manutenções e troca de óleo)
    match /maintenance/{maintenanceId} {
      allow read, write: if true;
    }

    // 12. Notifications (alertas e avisos do sistema)
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 13. Vehicle Checklists (inspeção veicular e anomalias)
    match /vehicleChecklists/{checklistId} {
      allow read: if true;
      allow create, update, delete: if isValidId(checklistId);
    }

    // 14. Trip Requests (solicitações de viagens pendentes para motoristas)
    match /tripRequests/{tripId} {
      allow read: if true;
      allow create, update, delete: if isValidId(tripId);
    }

    // 15. FCM Device Tokens (notificações push para motoristas)
    function isValidFcmToken(data) {
      return data.keys().hasAll(['id', 'driverId', 'driverName', 'token', 'registrationMode', 'platform', 'enabled', 'notifyTrips', 'notifyMaintenance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'driverId', 'driverName', 'vehicleId', 'token', 'registrationMode', 'platform', 'browserLabel', 'enabled', 'notifyTrips', 'notifyMaintenance', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.driverId is string && data.driverId.size() > 0 && data.driverId.size() <= 128
        && data.driverName is string && data.driverName.size() > 0 && data.driverName.size() <= 120
        && (!('vehicleId' in data) || (data.vehicleId is string && data.vehicleId.size() <= 128))
        && data.token is string && data.token.size() > 0 && data.token.size() <= 512
        && data.registrationMode in ['fcm', 'web_push_fallback']
        && data.platform == 'web'
        && (!('browserLabel' in data) || (data.browserLabel is string && data.browserLabel.size() <= 120))
        && data.enabled is bool
        && data.notifyTrips is bool
        && data.notifyMaintenance is bool
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /fcmTokens/{tokenId} {
      allow read: if true;
      allow create, update: if isValidId(tokenId) && isValidFcmToken(request.resource.data);
      allow delete: if isValidId(tokenId);
    }
  }
}
